{
  "version": 2,
  "routes": [
    { "src": "/serverdeploy/api/(.*)", "dest": "/api/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },

    { "src": "/static_preview/(.*)", "dest": "/static_preview/$1" },

    {
      "src": "/(.*\\.(?:js|css|map|png|jpg|jpeg|gif|svg|webp|ico|json))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/$1"
    },

    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
